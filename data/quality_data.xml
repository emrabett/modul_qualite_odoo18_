        <!-- Séquences pour les modèles de qualité -->
        
        <!-- Séquence pour les plans de contrôle qualité -->
        <record id="seq_quality_plan1" model="ir.sequence">
            <field name="name">Plan de Contrôle Qualité</field>
            <field name="code">quality.plan1</field>
            <field name="prefix">PQ</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
        </record>
        
        <!-- Séquence pour les points de contrôle -->
        <record id="seq_quality_point1" model="ir.sequence">
